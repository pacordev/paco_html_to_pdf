  "cards": [
    { "dot": "cyan", "title": "Authorization & errors", "items": ["contact query param must match the invoice's client email or phone, else 403", "unknown invoice_number returns 404 before the contact check runs", "one JOIN query pulls invoice + company + client, a second query pulls line items"] },
    { "dot": "emerald", "title": "Database schema", "items": ["tables: companies, clients, invoices, invoice_items", "invoice_items.line_total is a generated column (quantity * unit_price)", "FKs + indexes on company_id/client_id/invoice_id", "schema.sql and seed_data.sql auto-run only on an empty data volume"] },
    { "dot": "violet", "title": "PDF generation", "items": ["pdf.py writes rendered HTML to a temp file inside templates/ so relative image paths (the logo) resolve", "pdfkit shells out to the wkhtmltopdf binary, then the temp file is deleted in a finally block", "page-size/margins are fixed to Letter with smart-shrinking disabled to avoid letterboxed output"] },
    { "dot": "amber", "title": "Deployment", "items": ["docker-compose runs api and db as separate containers on one network", "api's depends_on waits for db's pg_isready healthcheck before starting", "Dockerfile installs the wkhtmltox .deb directly since it was dropped from Debian's own repos", "DATABASE_URL switches between a localhost default and the db service hostname"] },
    { "dot": "rose", "title": "Two endpoints, one pipeline", "items": ["GET /invoices/{invoice_number} returns rendered HTML and stops at the template stage", "GET /createpdf/{invoice_number} continues on to PDF Renderer + wkhtmltopdf", "filename query param is sanitized (only A-Z a-z 0-9 . _ -) before use in the Content-Disposition header"] }
  ]
